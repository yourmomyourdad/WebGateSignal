{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webgate-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",

  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING",
        "class_name": "Signaling"
      }
    ]
  },

  "exports": {
    "Signaling": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
